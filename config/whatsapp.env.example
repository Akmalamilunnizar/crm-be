# Meta WhatsApp Business API Configuration
# Get these from https://developers.facebook.com/apps/

# Meta Graph API URL (use latest version)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Your WhatsApp Business API Access Token
# Get this from Meta Business Manager > WhatsApp > API Setup
WHATSAPP_API_TOKEN=your_meta_access_token_here

# Your WhatsApp Business Phone Number ID
# Get this from Meta Business Manager > WhatsApp > API Setup
WHATSAPP_PHONE_ID=your_phone_number_id_here

# Optional: Webhook verification token (for receiving messages)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Optional: App Secret (for webhook verification)
WHATSAPP_APP_SECRET=your_app_secret_here
